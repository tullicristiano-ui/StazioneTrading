# Provider selection
AI_PROVIDER=openrouter

# OpenRouter API
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# HuggingFace / Gemma API
# Supported names: HUGGINGFACE_API_KEY or HF_TOKEN
HUGGINGFACE_API_KEY=hf-your-key-here
HF_TOKEN=hf-your-key-here
HUGGINGFACE_MODEL=google/gemma-2-9b-it
HF_MODEL=google/gemma-2-9b-it
# Timeout in ms per la risposta dell'AI HuggingFace (default 90s)
HF_TIMEOUT_MS=90000

# Server Config
PORT=3001
DB_PATH=./server/data/aware_trading.db
UPLOADS_PATH=./server/uploads

# Environment
NODE_ENV=development

# Vision locale (Ollama + Qwen2.5-VL)
# Attiva la lettura immagini locale. Richiede Ollama installato e il modello scaricato.
# Lascia false finché non hai installato Ollama e scaricato il modello con: ollama pull qwen2.5vl:3b
VISION_LOCAL_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# Timeout in ms per la chiamata vision durante l'analisi (default 30s)
VISION_TIMEOUT_MS=30000
# Timeout in ms per il pre-caricamento del modello vision all'avvio (default 120s)
VISION_WARMUP_TIMEOUT_MS=120000
